# GABLS1 stable boundary layer (Beare et al. 2006) on flat ground with the
# Kosovic model. The surface cools at 0.25 K/hr from 265 K and the
# ABLWallFunction gives the surface fluxes. This is the flat reference for
# abl_stable_kosovic_offset, which raises the ground by 50 m with TerrainDrag.

time.stop_time                  = 32400.0
time.max_step                   = 10
time.fixed_dt                   = -1.0
time.cfl                        = 0.5
time.plot_interval              = 10
time.checkpoint_interval        = -1

incflo.physics                  = ABL
incflo.gravity                  = 0.0 0.0 -9.81
incflo.density                  = 1.3223
incflo.velocity                 = 8.0 0.0 0.0
incflo.use_godunov              = 1
incflo.godunov_type             = "weno_z"
incflo.diffusion_type           = 2
incflo.verbose                  = 0
transport.viscosity             = 0.0
transport.laminar_prandtl       = 0.7
transport.turbulent_prandtl     = 0.3333
transport.reference_temperature = 263.5
turbulence.model                = Kosovic
ICNS.source_terms               = BoussinesqBuoyancy CoriolisForcing GeostrophicForcing NonLinearSGSTerm
CoriolisForcing.east_vector     = 1.0 0.0 0.0
CoriolisForcing.north_vector    = 0.0 1.0 0.0
CoriolisForcing.latitude        = 90.0
CoriolisForcing.rotational_time_period = 90405.5439881955
GeostrophicForcing.geostrophic_wind = 8.0 0.0 0.0

ABL.temperature_heights         = 0.0 100.0 400.0
ABL.temperature_values          = 265.0 265.0 268.0
ABL.perturb_temperature         = false
ABL.cutoff_height               = 50.0
ABL.perturb_velocity            = true
ABL.perturb_ref_height          = 50.0
ABL.Uperiods                    = 4.0
ABL.Vperiods                    = 4.0
ABL.deltaU                      = 0.5
ABL.deltaV                      = 0.5
ABL.kappa                       = 0.40
ABL.mo_gamma_m                  = 4.8
ABL.mo_gamma_h                  = 7.8
ABL.surface_roughness_z0        = 0.1
ABL.surface_temp_rate           = -0.25
ABL.surface_temp_init           = 265.0
ABL.wall_shear_stress_type      = local
ABL.normal_direction            = 2
ABL.stats_output_frequency      = 100
ABL.stats_output_format         = ascii

amr.n_cell                      = 32 32 32
amr.max_level                   = 0
geometry.prob_lo                = 0.0 0.0 0.0
geometry.prob_hi                = 400.0 400.0 400.0
geometry.is_periodic            = 1 1 0

zlo.type                        = "wall_model"
zlo.temperature_type            = "wall_model"
zhi.type                        = "slip_wall"
zhi.temperature_type            = "fixed_gradient"
zhi.temperature                 = 0.01
